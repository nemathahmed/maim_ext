{
  "manifest_version": 3,
  "name": "React Chrome Extension",
  "version": "1.0",
  "permissions": [
    "tabCapture",
    "scripting",
    "activeTab",
    "storage",
    "tabs",
    "downloads",
    "downloads.shelf",
    "sidePanel",
    "debugger",
    "desktopCapture",
        "webNavigation"
  ],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Workflow Chat Buddy"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js",   "rrweb.min.js", "html2canvas.min.js"]
    }
  ],
  "web_accessible_resources": [{
    "resources": ["rrweb.min.js", "html2canvas.min.js", "background.js"],
    "matches": ["<all_urls>"]
  }]
}
